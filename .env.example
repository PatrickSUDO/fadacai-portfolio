# ============================================================
# briefing-auto-send configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Step 1: https://t.me/BotFather → send /newbot → follow prompts
# Step 2: https://t.me/userinfobot → send /start → note your numeric ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMTP (Gmail recommended) ──────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords
# Generate a 16-character app password (not your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# ── Schedule (used by briefing_runner.sh) ────────────────────
# 台股收盤 13:30，盤後三大法人買賣超約 14:00 前公布，故預設收盤後推送
BRIEFING_TIMEZONE=Asia/Taipei
BRIEFING_HOUR=14

# ── Behavior ─────────────────────────────────────────────────
FRIDAY_CODEX=true           # add --codex on Fridays (independent Codex second opinion)
SKIP_NON_TRADING_DAYS=true  # skip weekends + TWSE holidays
RETRY_MAX=3                 # max send retry attempts before error notification

# ── 台灣總經 snapshot (fetch_macro.py) ───────────────────────
# 來源以 FinMind 台灣總經資料為主（央行重貼現率 / CPI / 10年公債殖利率 /
# USD-TWD / 台指 VIX）。若 FINMIND_TOKEN 留空，總經快照會被跳過並優雅 fallback。

# ── FinMind fundamentals (fetch_fundamentals.py / fetch_macro.py) ─────
# Free token at https://finmindtrade.com/analysis/#/account/login → API Token
# 用於基本面快照（本益比/PEG/殖利率/法人/月營收/季成長）與總經時間序列
FINMIND_TOKEN=
# Optional override: comma-separated 4 碼代號 when no journal exists yet
# FUNDAMENTALS_TICKERS=2330,2454,2308,3034,3661

# ── Earnings / 月營收 history (earnings_history.py) ───────────
# Optional override: comma-separated 4 碼代號 when no journal exists yet
# Defaults to parsing tickers from the latest journal/YYYY-MM-DD.md
# EARNINGS_TICKERS=2330,2454,3661,3034
