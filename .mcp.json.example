{
  "_comment": "Copy to .mcp.json and fill in your own paths + API tokens. .mcp.json is gitignored (contains secrets). All 7 台股 MCP servers below; omit any you don't use.",
  "mcpServers": {
    "technical": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/fadacai-mcp-servers/technical", "run", "server.py"]
    },
    "finmind-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/finmind-server", "run", "server.py"],
      "env": {
        "FINMIND_TOKEN": "YOUR_FINMIND_TOKEN_HERE"
      }
    },
    "chip-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/fadacai-mcp-servers/chip", "run", "server.py"]
    },
    "cnyes-news": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/cnyes-news", "run", "server.py"]
    },
    "mops-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/mops-server", "run", "server.py"]
    },
    "twse-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/twse-server", "run", "server.py"]
    },
    "shioaji-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/abs/path/to/shioaji-server", "run", "server.py"],
      "env": {
        "SHIOAJI_API_KEY": "YOUR_SHIOAJI_API_KEY",
        "SHIOAJI_SECRET_KEY": "YOUR_SHIOAJI_SECRET_KEY"
      }
    }
  }
}
