# Copy to .env (same dir as server.py). Gitignored — never commit real credentials.
# 永豐金證券 Shioaji API 金鑰（個人首頁 → API 金鑰管理）
SHIOAJI_API_KEY=your_shioaji_api_key
SHIOAJI_SECRET_KEY=your_shioaji_secret_key
# 憑證（僅下單需要；純查詢可留空）
SHIOAJI_CA_PATH=~/.local/share/shioaji/Sinopac.pfx
SHIOAJI_CA_PASSWD=your_ca_password
SHIOAJI_PERSON_ID=your_id_number
